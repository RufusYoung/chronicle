      "repeat_policy": "once_per_action",
      "result_title": "请{target_display_name}帮忙",
      "result_summary": "你请对方兑现一份人情；这次请求已经被记下。",
      "hint": "消耗一部分人情；同一对象只能请求一次。",
      "hours": 1,
      "decision_intent": "动用一段关系",
      "known_cost": "花费 {hours} 小时，并消耗一部分人情",
      "known_effect": "让对方以自己的知识或能力回应当前需求",
      "tradeoff": "这份人情之后不能原样再用一次",
      "priority": 210,
      "target": {
        "type": "person",
        "state_equals": {
          "visible": true
        }
      },
