      "transaction_mode": "effect_template",
      "effect_template_id": "ask_market_pressure_effect",
      "label_template": "向附近的人打听粮价",
      "repeat_policy": "once_per_action",
      "result_title": "市场上的缺粮传言",
      "result_summary": "几家粮铺都在缩短开门时间。北路运粮车迟迟没到，涨价还会继续。",
      "hint": "打听一次当前市场的粮食压力。",
      "hours": 1,
      "decision_intent": "了解公共局势",
      "known_cost": "花费 {hours} 小时",
      "known_effect": "确认本地短缺如何影响商户与货路",
      "tradeoff": "获得的是公共消息，不保证能解决眼前人物的问题",
      "priority": 100,
      "location_tags_all": [
        "food_related"
      ],
      "region_state_equals": {
        "food_pressure": "high"
      }
    },
