{
  "rules": [
    {
      "rule_id": "approach_visible_person",
      "domain": "basic",
      "action_type": "dialogue",
      "transaction_mode": "effect_template",
      "effect_template_id": "approach_person_effect",
      "label_template": "[对话] 走近{target_display_name}",
      "repeat_policy": "once_per_action",
      "result_title": "走近{target_display_name}",
      "result_summary": "你走近{target_display_name}，留意到对方如何回应。",
      "hint": "先观察对方的反应，再决定如何交谈。",
      "priority": 10,
      "target": {
        "type": "person",
        "state_equals": {
          "visible": true
        }
      }
    },
    {
      "rule_id": "give_food_to_hungry_person",
      "domain": "basic",
      "action_type": "normal",
      "transaction_mode": "effect_template",
      "effect_template_id": "give_food_help_effect",
      "label_template": "[普通] 给{target_display_name}食物",
      "repeat_policy": "once_per_action",
      "result_title": "递出一份食物",
      "result_summary": "对方接过食物，饥饿缓和了一些。",
      "hint": "消耗 1 份食物，也会改变对方对你的态度。",
      "priority": 20,
      "target": {
        "type": "person",
        "state_equals": {
          "visible": true
        },
        "state_in": {
          "hunger": [
            "extreme",
            "high"
          ]
        }
      },
      "player_min": {
        "food_count": 1
      }
    },
    {
      "rule_id": "ask_about_concealed_item",
      "domain": "basic",
      "action_type": "dialogue",
      "transaction_mode": "effect_template",
      "effect_template_id": "inquiry_concealed_item_effect",
      "label_template": "[对话] 问{target_display_name}藏着什么",
      "repeat_policy": "once_per_action",
      "result_title": "问起藏着的东西",
      "result_summary": "对方意识到你注意到了被藏起来的东西。",
      "hint": "直接询问可能带来线索，也可能让对方戒备。",
      "priority": 30,
      "target": {
        "type": "person",
        "state_equals": {
          "visible": true
        },
        "state_has": [
          "concealment"
        ]
      }
    },
    {
      "rule_id": "read_visible_readable_object",
      "domain": "basic",
      "action_type": "normal",
      "transaction_mode": "effect_template",
      "effect_template_id": "read_object_effect",
      "label_template": "[普通] 阅读{target_display_name}",
      "repeat_policy": "once_per_action",
      "result_title": "读完{target_display_name}",
      "result_summary": "{target_description}",
      "hint": "阅读后，这条信息会进入已经确认的事实。",
      "priority": 40,
      "target": {
        "state_equals": {
          "visible": true,
          "readable": true
        },
        "tags_any": [
          "readable_notice",
          "readable_record"
        ]
      }
    },
    {
      "rule_id": "inspect_visible_trace",
      "domain": "basic",
      "action_type": "clue",
      "transaction_mode": "effect_template",
      "effect_template_id": "inspect_trace_effect",
      "label_template": "[线索] 查看{target_display_name}",
      "repeat_policy": "once_per_action",
      "result_title": "检查{target_display_name}",
      "result_summary": "{target_description}",
      "hint": "检查后，这处痕迹会转化为可追溯的事实。",
      "priority": 50,
      "target": {
        "type": "trace",
        "state_equals": {
          "visible": true,
          "inspectable": true
        }
      }
    }
  ]
}
