{
  "rules": [
    {
      "rule_id": "merchant_rations_stock_for_hungry_dependent",
      "actor": {
        "type": "person",
        "tags_all": [
          "merchant",
          "local_family"
        ],
        "state_equals": {
          "decision_enabled": true
        }
      },
      "bindings": {
        "dependent_id": {
          "source": "actor_state",
          "key": "dependent_id"
        },
        "workplace_id": {
          "source": "actor_state",
          "key": "workplace_id"
        },
        "price_notice_id": {
          "source": "actor_state",
          "key": "price_notice_id"
        },
        "closing_detail_id": {
          "source": "actor_state",
          "key": "closing_detail_id"
        },
        "dependent_display_name": {
          "source": "entity_display_name",
          "entity_id": "{dependent_id}"
        }
      },
      "once_fact_type": "merchant_closed_shop_early",
      "minimum_utility": 60,
      "priority": 20,
      "requirements": [
        {
          "source": "entity_state",
          "key": "shop_policy",
          "not_equals": "closed"
        }
      ],
      "utility_factors": [
        {
          "factor_id": "regional_food_pressure",
          "label": "镇上的粮食压力很高",
          "weight": 35,
          "condition": {
            "source": "region_state",
            "key": "food_pressure",
            "in": [
              "high",
              "extreme"
            ]
          }
        },
        {
          "factor_id": "dependent_is_hungry",
          "label": "{dependent_display_name}仍在挨饿",
          "weight": 40,
          "condition": {
            "source": "entity_state",
            "entity_id": "{dependent_id}",
            "key": "hunger",
            "in": [
              "high",
              "extreme"
            ]
          }
        },
        {
          "factor_id": "market_order_is_tense",
          "label": "市场秩序紧张",
          "weight": 5,
          "condition": {
            "source": "institution",
            "key": "market_order",
            "equals": "tense"
          }
        }
      ],
      "effects": {
        "facts": [
          {
            "fact_id": "merchant_closed_shop_early:{actor_id}:{tick_event_id}",
            "fact_type": "merchant_closed_shop_early",
            "actor_id": "{actor_id}",
            "target_id": "{workplace_id}",
            "location_id": "{location_id}",
            "source_rule_id": "{rule_id}",
            "summary": "{actor_display_name}在缺粮和家人挨饿的压力下提前收铺。"
          }
        ],
        "state_changes": [
          {
            "entity_id": "{actor_id}",
            "key": "shop_policy",
            "to": "rationing",
            "reason": "protect_household_food"
          },
          {
            "entity_id": "{price_notice_id}",
            "key": "price_level",
            "to": "raised_again",
            "reason": "merchant_rations_scarce_stock"
          },
          {
            "entity_id": "{closing_detail_id}",
            "key": "visible",
            "to": true,
            "reason": "merchant_closes_shop_early"
          }
        ],
        "pressure_changes": [
          {
            "pressure_id": "merchant_early_closing:{actor_id}:{tick_event_id}",
            "scope_id": "{workplace_id}",
            "scope_type": "location",
            "domain": "food_crisis",
            "pressure_type": "market_shortage",
            "value": 10,
            "source_fact_type": "merchant_closed_shop_early"
          }
        ],
        "narrative": {
          "title": "铺子提前收门",
          "summary": "{dependent_display_name}还饿着，街上的粮价也在往上窜。{actor_display_name}从后屋拖出门板，准备提前收铺；他要把今天能卖的份额留给家里。",
          "tone": "uneasy"
        }
      }
    },
    {
      "rule_id": "merchant_keeps_trading_after_dependent_hunger_eases",
      "actor": {
        "type": "person",
        "tags_all": [
          "merchant",
          "local_family"
        ],
        "state_equals": {
          "decision_enabled": true
        }
      },
      "bindings": {
        "dependent_id": {
          "source": "actor_state",
          "key": "dependent_id"
        },
        "workplace_id": {
          "source": "actor_state",
          "key": "workplace_id"
        },
        "dependent_display_name": {
          "source": "entity_display_name",
          "entity_id": "{dependent_id}"
        }
      },
      "once_fact_type": "merchant_kept_shop_open",
      "minimum_utility": 50,
      "priority": 10,
      "requirements": [
        {
          "source": "entity_state",
          "key": "shop_policy",
          "equals": "open"
        }
      ],
      "utility_factors": [
        {
          "factor_id": "dependent_hunger_eased",
          "label": "{dependent_display_name}的饥饿已经缓和",
          "weight": 40,
          "condition": {
            "source": "entity_state",
            "entity_id": "{dependent_id}",
            "key": "hunger",
            "in": [
              "medium",
              "low",
              "none"
            ]
          }
        },
        {
          "factor_id": "shop_income_matters",
          "label": "继续营业能换回下一批粮",
          "weight": 15,
          "condition": {
            "source": "entity_state",
            "key": "shop_policy",
            "equals": "open"
          }
        },
        {
          "factor_id": "customers_still_need_food",
          "label": "镇上仍有人等着买粮",
          "weight": 10,
          "condition": {
            "source": "region_state",
            "key": "food_pressure",
            "in": [
              "high",
              "extreme"
            ]
          }
        }
      ],
      "effects": {
        "facts": [
          {
            "fact_id": "merchant_kept_shop_open:{actor_id}:{tick_event_id}",
            "fact_type": "merchant_kept_shop_open",
            "actor_id": "{actor_id}",
            "target_id": "{workplace_id}",
            "location_id": "{location_id}",
            "source_rule_id": "{rule_id}",
            "summary": "家里的饥饿缓和后，{actor_display_name}决定继续营业。"
          }
        ],
        "state_changes": [
          {
            "entity_id": "{actor_id}",
            "key": "shop_policy",
            "to": "open",
            "reason": "family_hunger_eased"
          }
        ],
        "narrative": {
          "title": "门板留在后屋",
          "summary": "{dependent_display_name}的饥色缓下来，包好的食物也还留着一半。{actor_display_name}看了看见底的粮罐，没有去拖门板，决定再做一阵生意。",
          "tone": "cautious_relief"
        }
      }
    },
    {
      "rule_id": "hungry_resident_walks_to_food_supplier",
      "actor": {
        "type": "person",
        "tags_all": [
          "living_needs",
          "food_buyer"
        ]
      },
      "bindings": {
        "home_location_id": {
          "source": "actor_state",
          "key": "home_location_id"
        },
        "home_location_name": {
          "source": "actor_state",
          "key": "home_location_name",
          "default": "原来的岗位"
        },
        "supplier_id": {
          "source": "actor_state",
          "key": "food_supplier_id"
        },
        "supplier_location_id": {
          "source": "actor_state",
          "key": "food_supplier_location_id"
        },
        "supplier_display_name": {
          "source": "entity_display_name",
          "entity_id": "{supplier_id}"
        },
        "duty_label": {
          "source": "actor_state",
          "key": "duty_label",
          "default": "手头的活"
        }
      },
      "minimum_utility": 60,
      "priority": 30,
      "requirements": [
        {
          "source": "entity_state",
          "key": "location_id",
          "equals": "{home_location_id}"
        },
        {
          "source": "entity_state",
          "key": "hunger",
          "in": [
            "high",
            "extreme"
          ]
        },
        {
          "source": "entity_state",
          "key": "food_stock",
          "max": 0
        },
        {
          "source": "entity_state",
          "key": "food_search_blocked",
          "not_equals": true
        }
      ],
      "base_utility": 70,
      "utility_factors": [
        {
          "factor_id": "no_food_left",
          "label": "身边已经没有食物",
          "weight": 25,
          "condition": {
            "source": "entity_state",
            "key": "food_stock",
            "max": 0
          }
        },
        {
          "factor_id": "hunger_is_extreme",
          "label": "饥饿已经难以忍受",
          "weight": 30,
          "condition": {
            "source": "entity_state",
            "key": "hunger",
            "equals": "extreme"
          }
        }
      ],
      "effects": {
        "facts": [
          {
            "fact_id": "npc_traveled_for_food:{actor_id}:{tick_event_id}",
            "fact_type": "npc_traveled_for_food",
            "actor_id": "{actor_id}",
            "target_id": "{supplier_id}",
            "from_location_id": "{home_location_id}",
            "location_id": "{supplier_location_id}",
            "source_rule_id": "{rule_id}",
            "summary": "{actor_display_name}放下{duty_label}，去找{supplier_display_name}买吃的。"
          }
        ],
        "state_changes": [
          {
            "entity_id": "{actor_id}",
            "key": "location_id",
            "to": "{supplier_location_id}",
            "reason": "seek_food_supplier"
          }
        ],
        "memories": [
          {
            "memory_id": "{actor_id}_left_work_hungry:{tick_event_id}",
            "owner_id": "{actor_id}",
            "source_fact_type": "npc_traveled_for_food",
            "memory_type": "left_duty_because_hungry",
            "emotional_tone": "embarrassed_urgency",
            "clarity": "high",
            "can_be_told_as_rumor": true
          }
        ],
        "traces": [
          {
            "trace_id": "abandoned_workplace:{actor_id}:{tick_event_id}",
            "trace_type": "abandoned_workplace",
            "location_id": "{home_location_id}",
            "source_fact_type": "npc_traveled_for_food",
            "actor_id": "{actor_id}",
            "display_name": "匆忙搁下的工作",
            "description": "{actor_display_name}把{duty_label}做到一半便离开了，桌面还保持着刚才的样子。",
            "visible": true,
            "inspectable": true,
            "freshness": "fresh"
          }
        ],
        "narrative": {
          "title": "{actor_display_name}来找吃的",
          "summary": "饥饿终于压过了职责。{actor_display_name}放下{duty_label}，从{home_location_name}赶到这里，想向{supplier_display_name}买一份食物。",
          "tone": "urgent"
        }
      }
    },
    {
