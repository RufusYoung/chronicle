[node name="IntroDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "CHRONICLE 内部试玩"
dialog_text = "你是一名途经湖湾镇的旅人。\n\n这次试玩的目标，是从废弃粮仓的异样一路追到雾盐旧井，并带着一次亲历返回北埠。旅行、等待和准备都会推进世界时间，失败也可能留下伤势与长期后果。\n\n当前版本尚未接入正式存档。左侧会持续显示当前目标。"
dialog_autowrap = true
ok_button_text = "开始试玩"

[node name="CompletionDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "这次旅程已经抵达终点"
dialog_text = "你已经从湖湾镇的粮仓旧事追到雾盐旧井，并带着这段亲历返回北埠。\n\n内部试玩目标已经完成。你可以留在当前世界继续观察，也可以使用右上角的“重新开始试玩”体验另一条选择。"
dialog_autowrap = true
ok_button_text = "继续留在世界"

[node name="FailureDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "这次追查在这里受挫"
dialog_text = "你承担了失败的后果，但当前内部试玩没有另一条路线能继续抵达雾盐旧井。\n\n可以留在世界里查看伤势与局面变化，也可以重新开始，并在危险行动前先完成准备。"
dialog_autowrap = true
ok_button_text = "查看这次后果"

[node name="RestartDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "重新开始这次试玩？"
dialog_text = "当前行动、发现、物品、伤势和世界时间都会被清空，并回到第 1 天的老陈铺子。"
dialog_autowrap = true
ok_button_text = "重新开始"
cancel_button_text = "保留当前局面"
