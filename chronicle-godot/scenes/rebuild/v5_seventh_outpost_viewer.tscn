[node name="IntroDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "第七哨站 · 新兵之冬"
dialog_text = "你进入第七哨站服役。\n\n这一轮内部试玩压缩了第一冬的七个值勤日。每天选择一项职责，补给、士气、军纪、哨墙、战备与边境压力会继续变化；罗恩、伊莱、玛塔、赛拉和霍克也会依据局面自行行动。\n\n七日不是完整五年，它用来验证长期生活的基本单位。"
dialog_autowrap = true
ok_button_text = "参加第一次点名"
theme_override_styles/panel = SubResource("panel")

[node name="CompletionDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
