  "events": [
	{
	  "id": "silence_entry",
	  "title": "进入沉默之森",
	  "text": "空气在此凝结成透明的墙。你刚踏入边界，所有声音被剥离，连心跳也变得迟钝。树叶的摆动在无声中如慢镜头般展开。",
	  "effects": [
		{"op": "set_flag", "key": "in_silent_forest", "val": true}
	  ],
	  "next": [
		{"id": "whispering_tree", "weight": 2},
		{"id": "wandering_light", "weight": 1}
	  ]
	},
	{
	  "id": "whispering_tree",
	  "title": "低语之树",
	  "text": "一棵树向你伸出根须，似乎在无声地邀请。你的意识被拉入一片梦境般的幻野——那里有林精、矮人、自由民三族的记忆交织。",
	  "conditions": [
		{"type": "flag_present", "key": "in_silent_forest"}
	  ],
	  "effects": [
		{"op": "add_mark", "mark": "heard_the_forest"}
	  ],
	  "next": [
		{"id": "memory_echo", "weight": 1},
		{"id": "silent_hunger", "weight": 1}
	  ]
	},
	{
	  "id": "memory_echo",
	  "title": "回声的回声",
	  "text": "你的梦境中，碎星山的矮人敲击着空洞的石壁。每一锤都回荡着‘记忆苏醒’的预兆。你醒来时，发现身边的岩石也在轻轻振动。",
	  "conditions": [
		{"type": "has_mark", "mark": "heard_the_forest"}
	  ],
	  "effects": [
		{"op": "inv_add", "key": "stone_fragment", "val": 1},
		{"op": "set_flag", "key": "heard_echo", "val": true}
	  ],
	  "next": [
		{"id": "forest_dream_end", "weight": 1}
	  ]
	},
	{
	  "id": "silent_hunger",
	  "title": "沉默的饥饿",
	  "text": "森林的寂静忽然变得锋利。你感到饥饿，却不知饥饿来自哪里。你的火把无法点燃，仿佛光也被噤声吞噬。",
	  "conditions": [
		{"type": "flag_present", "key": "in_silent_forest"}
	  ],
	  "effects": [
		{"op": "inv_consume", "key": "food", "val": 2}
	  ],
	  "next": [
		{"id": "forest_dream_end", "weight": 1}
	  ]
	},
	{
	  "id": "forest_dream_end",
	  "title": "梦醒时分",
	  "text": "你在回音的森林中醒来，掌心紧握着一块微微颤动的石头。它似乎在低语，呼唤你深入镜湖的方向。梦境和现实的界线，开始模糊。",
	  "conditions": [
		{"type": "flag_present", "key": "heard_echo"}
	  ],
	  "effects": [
		{"op": "set_flag", "key": "forest_dream_done", "val": true},
		{"op": "add_mark", "mark": "dreamer"}
	  ]
	}
  ],

